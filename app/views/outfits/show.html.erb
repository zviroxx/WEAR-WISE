<div class="outfit-show-container">
  <div class="outfit-show-card">
    <div class="outfit-show-image">
      <% if @outfit.photo.attached? %>
        <%= cl_image_tag(@outfit.photo.key, class: "outfit-photo") %>
      <% end %>
    </div>
    <div class="outfit-show-content">
      <h1><%= @outfit.name %></h1>
      <span class="season-tag">
        <%= @outfit.season %>
      </span>
      <div class="outfit-description">
        <h3>Outfit details</h3>
        <p><%= @outfit.details %></p>
      </div>
      <div class="outfit-actions">
        <%= link_to "← Back to my outfits", outfits_path, class: "normal-btn" %>
        <%= link_to "Edit", edit_outfit_path(@outfit), class: "normal-btn" %>
        <%= link_to "Delete", outfit_path(@outfit),
            class: "normal-btn",
            data: {
              turbo_method: :delete,
              turbo_confirm: "Are you sure? \n\nThese changes cannot be reversed"
            } %>
      </div>
    </div>
  </div>
</div>
