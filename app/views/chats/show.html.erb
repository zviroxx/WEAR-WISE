<%= turbo_stream_from @chat %>

<div class="title-container">
  <h1 id="chat_title" class="chat-title"><%= @chat.title %></h1>
</div>

<div class="container chat-card">
  <div id="messages" class="chat-messages" data-controller="scroll-bottom">
    <%= render partial: "messages/message", collection: @chat.messages.order(:created_at) %>
  </div>

  <div id="new_message_container" class="chat-form">
    <%= render "messages/form", chat: @chat, message: @message %>
  </div>
</div>
