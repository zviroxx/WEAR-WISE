<div class="home-dashboard">
  <div class="dashboard-title">
    <h3>Everything you need to create your perfect look.</h3>
  </div>
  <div class="dashboard-cards">
    <div class="dashboard-card">
      <%= image_tag "https://i.imgur.com/efp6cXg.png", alt: "My wardrobe" %>
      <h3>My wardrobe</h3>
      <p>Explore all your saved outfits and keep your favourite looks in one place.</p>
      <%= link_to "Explore wardrobe", outfits_path, class: "normal-btn" %>
    </div>
    <div class="dashboard-card">
      <%= image_tag "https://i.imgur.com/iPCz4NR.png", alt: "Wear Wise AI" %>
      <h3>Wear Wise AI</h3>
      <p>Let AI help you find your next outfit with personalised suggestions.</p>
      <%= link_to "Try AI Stylist", chats_path, data: { 'turbo-method' => :post }, class: "normal-btn" %>
    </div>
    <div class="dashboard-card">
      <%= image_tag "https://i.imgur.com/Yh6avnq.png", alt: "New outfit" %>
      <h3>New Outfit</h3>
      <p>Create a new look all by yourself.</p>
      <%= link_to "Create outfit", new_outfit_path, class: "normal-btn" %>
    </div>
  </div>
</div>
